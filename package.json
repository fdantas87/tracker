{
  "name": "tracking-panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:actions && npm run check:setup-sql && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:actions": "node scripts/check-server-actions.mjs",
    "check:setup-sql": "node scripts/build-setup-sql.mjs --check",
    "build:setup-sql": "node scripts/build-setup-sql.mjs",
    "verify:dispatch": "node scripts/verify-dispatch.mjs",
    "verify:captura": "node scripts/verify-captura.mjs",
    "seed": "node scripts/seed-events.mjs",
    "seed:limpar": "node scripts/seed-events.mjs --limpar",
    "prepare": "husky"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.82",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "anychart": "^8.14.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "d3-geo": "^3.1.1",
    "framer-motion": "^13.4.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "react-simple-maps": "^5.0.5",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
